{
  // Cloudflare Workers 設定
  // 参考: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albe-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 静的ファイル（public/）。ベーシック認証を効かせるため Worker を先に実行し、
  // ASSETS バインディング経由で配信する（src/index.ts の catch-all を参照）。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // D1 データベース（ローカル開発では --local で SQLite が使われる）
  // database_id は本番D1のID（機密ではない）。別環境で作り直した場合は
  // `node scripts/set-d1-id.mjs <新しいID>` で差し替える。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "albe_booking",
      "database_id": "0f12f0d8-a87a-4194-9902-bed75d6ea47e",
      "migrations_dir": "migrations"
    }
  ],
  // カスタムドメイン。デプロイ時に booking.space-albe.com を Worker に接続し、
  // DNSレコードとSSL証明書を Cloudflare が自動発行する（ゾーンは同一アカウント）。
  // workers.dev のURL（albe-booking-api.rental-space-albe.workers.dev）も引き続き有効。
  "routes": [
    { "pattern": "booking.space-albe.com", "custom_domain": true }
  ],
  "vars": {
    "APP_ENV": "development",
    // 領収書・請求書の閲覧リンクや通知メール内リンクの基底URL（本番の顧客向けドメイン）。
    "PUBLIC_BASE_URL": "https://booking.space-albe.com",
    // お客様宛メールの控え（エビデンス）BCC先（#106・本番のみ）。打ち合わせの証跡・電話対応で
    // 「お客様の手元と同じ本文」を参照するため。管理者宛の内部通知と認証系は複製しない。
    // ※ staging には env.staging.vars に載せないので複製されない（さらに staging は実送信自体を停止）。
    "MAIL_BCC": "rental-test@space-albe.com"
  },
  // 定期実行（Cron）。
  //  - "*/5 * * * *": 5分間隔でGoogleカレンダー取りこぼし補完（#25/#27）
  //  - "0 0 * * *"  : 毎日 00:00 UTC（＝日本時間 09:00）に未入金アラート（#41/#42）等
  //  - "0 0 * * 1"  : 毎週月曜 00:00 UTC（＝日本時間 月曜 09:00）に週次「今週の予約」まとめ（#111）
  "triggers": {
    "crons": ["*/5 * * * *", "0 0 * * *", "0 0 * * 1"]
  },
  // ───────────────────────────────────────────────────────────────
  // ステージング（テスト環境）#84
  // 本番（booking.space-albe.com）とは「別Worker・別D1・別シークレット」の
  // 完全独立した検証用環境。ここで自由に予約・決済・変更をテストしても、
  // 本番の予約データ・売上・Googleカレンダー・お客様メールには一切影響しない。
  //   デプロイ : npm run deploy:staging     （= wrangler deploy --env staging）
  //   マイグレ : npm run db:migrate:staging
  //   URL     : https://albe-booking-api-staging.<workers.devサブドメイン>.workers.dev
  // ※初回のみ、別D1の作成とシークレット投入を手動で行う（docs/staging-setup.md）。
  "env": {
    "staging": {
      "name": "albe-booking-api-staging",
      // 【重要】routes は named environment に継承されるため、必ず空で上書きする。
      // これを省くと本番ドメイン booking.space-albe.com をステージングが奪ってしまう。
      // ステージングは workers.dev のURLだけで配信する。
      "routes": [],
      "workers_dev": true,
      "observability": {
        "enabled": true
      },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      // ステージング専用D1（本番とは完全に別のデータベース）。
      // 初回に `wrangler d1 create albe_booking_staging` で発行したIDを
      // `node scripts/set-d1-id.mjs <ID> --staging` で下の PLACEHOLDER に差し替える。
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "albe_booking_staging",
          "database_id": "PLACEHOLDER_STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        // workers.dev のサブドメインが異なる場合はここを実URLに合わせる。
        "PUBLIC_BASE_URL": "https://albe-booking-api-staging.rental-space-albe.workers.dev"
      },
      // ステージングでは自動Cron（未入金アラート・自動解放・リマインド等）を止め、
      // 本番の管理者受信箱にテスト由来の通知が飛ばないようにする。
      // Cronの挙動を試したいときは一時的に本番と同じ配列を入れて検証する。
      "triggers": {
        "crons": []
      }
    }
  }
}
