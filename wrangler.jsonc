{
  // Cloudflare Workers 設定
  // 参考: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albe-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 静的ファイル（public/）。ベーシック認証を効かせるため Worker を先に実行し、
  // ASSETS バインディング経由で配信する（src/index.ts の catch-all を参照）。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // D1 データベース（ローカル開発では --local で SQLite が使われる）
  // ※ database_id は Cloudflare でDBを作成後に差し替える。ローカル開発には不要。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "albe_booking",
      "database_id": "REPLACE_WITH_REAL_ID_AFTER_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "development"
  }
}
